# GEMINI_API_KEY: Clave de Google AI Studio / Gemini API para el asistente virtual de Risknet
GEMINI_API_KEY="AIzaSy..."

# APP_URL: URL base pública donde estará alojada tu aplicación (ej: https://tudominio.com)
APP_URL="https://tudominio.com"

# PORT: Puerto en el que correrá el servidor Express (ej: 3000 o el asignado por tu hosting)
PORT=3000

# NODE_ENV: Modo de ejecución (production para producción, development para local)
NODE_ENV=production

# ADMIN_EMAIL: Correo oficial del CISO para recepción de alertas de leads y diagnósticos
ADMIN_EMAIL="aurbina@risknet.us"
